# =====================================================================================================
# MLOps agent configuration. Copy to .env (git-ignored) - `python start.py` does this for you.
#
# The defaults run the bundled LOCAL demo stack (docker compose + kind).
# To point the agent at YOUR OWN systems, change the "where" settings in each section below.
# An empty value (KEY=) means "use the default". Never commit real secrets.
# =====================================================================================================

# --- LLM (Google Gemini) ------------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id. "*-latest" aliases resolve server-side (pin e.g. gemini-3.5-flash-lite for stable demos)
GEMINI_MODEL=gemini-flash-lite-latest
# "*-latest" aliases are only served on v1beta; pinned models also work on v1
GEMINI_API_VERSION=v1beta
GEMINI_TEMPERATURE=0.1

# --- DVC: where the versioned datasets live --------------------------------------------------------------
# Git + DVC project the dataset tools inspect. Empty = this project folder.
# Your own project:  MLOPS_REPO_ROOT=C:/path/to/your/dvc-project   (absolute, or relative to this folder)
MLOPS_REPO_ROOT=
# Dataset used when a question doesn't name one, and the git-tag prefix that marks dataset versions
DVC_DEFAULT_DATASET=data/raw/churn.csv
DVC_DATASET_TAG_PREFIX=data-
DVC_TIMEOUT_S=60

# --- MLflow: experiments, runs, model registry ------------------------------------------------------------
# Local demo server (docker compose). Your own:  MLFLOW_TRACKING_URI=https://mlflow.company.com
MLFLOW_TRACKING_URI=http://localhost:5000
# Only if your MLflow server requires authentication:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
# MLFLOW_TRACKING_TOKEN=

# --- Airflow 3: training pipelines -------------------------------------------------------------------------
# Local demo server (docker compose). Your own:  AIRFLOW_BASE_URL=https://airflow.company.com
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
# Used by the agent to log in AND by docker compose to create the local admin user.
# start.py generates a random one if this is empty or "change-me".
AIRFLOW_ADMIN_PASSWORD=change-me
# Comma-separated DAG ids the agent is allowed to trigger (after user confirmation)
AIRFLOW_APPROVED_DAGS=churn_training_pipeline

# --- Kubernetes: the deployed application ------------------------------------------------------------------
# kubeconfig the agent uses. Default: restricted ServiceAccount created by start.py for the local kind cluster.
# Your own cluster (EKS/GKE/AKS/...):  K8S_KUBECONFIG=C:/path/to/a/restricted/kubeconfig
# (use a namespace-scoped, least-privilege identity - see kubernetes/agent-rbac.yaml for the permissions needed)
K8S_KUBECONFIG=.secrets/agent.kubeconfig
# Optional: context inside that kubeconfig (empty = its current-context)
K8S_CONTEXT=
# Default namespace, and the only namespaces the agent may read or change (comma-separated)
K8S_NAMESPACE=mlops
K8S_APPROVED_NAMESPACES=mlops
# Only Deployments with this label can be restarted/scaled/rolled back
K8S_MANAGED_LABEL=app.kubernetes.io/part-of=mlops-agent
K8S_MAX_REPLICAS=5

# --- Agent API (python start.py --api) --------------------------------------------------------------------
# Set to require an X-API-Key header on /agent/* endpoints (recommended beyond local use)
AGENT_API_KEY=

# --- Retraining policy -------------------------------------------------------------------------------------
RETRAIN_MAX_MODEL_AGE_DAYS=30
RETRAIN_MIN_PRODUCTION_F1=0.45
