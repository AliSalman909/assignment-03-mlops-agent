# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_API_VERSION=v1beta      # *-latest aliases are only served on v1beta
# GEMINI_TEMPERATURE=0.1

# --- Airflow 3 (docker compose reads AIRFLOW_ADMIN_PASSWORD to create the admin user) ---
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_APPROVED_DAGS=churn_training_pipeline

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- DVC ---
DVC_TIMEOUT_S=60
DVC_DEFAULT_DATASET=data/raw/churn.csv

# --- Kubernetes ---
# restricted agent kubeconfig created by scripts/k8s_agent_kubeconfig.sh
K8S_KUBECONFIG=.secrets/agent.kubeconfig
K8S_NAMESPACE=mlops
K8S_APPROVED_NAMESPACES=mlops
